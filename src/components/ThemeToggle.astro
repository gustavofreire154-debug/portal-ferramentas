---
// Botão de alternar tema. Um script pequeno troca a classe "dark" no
// <html> e salva a escolha no localStorage (assim ela persiste entre
// visitas). Como isso roda direto no navegador, não usa React nem
// nenhuma "ilha" — é JS puro e mínimo.
---

<button
  id="theme-toggle"
  type="button"
  aria-label="Alternar tema claro/escuro"
  class="grid h-9 w-9 place-items-center rounded-lg border transition hover:border-[var(--color-accent)]"
  style="border-color: var(--color-border);"
>
  <svg id="icon-sun" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="hidden h-4 w-4">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
  </svg>
  <svg id="icon-moon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="hidden h-4 w-4">
    <path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5Z"></path>
  </svg>
</button>

<script>
  const root = document.documentElement;
  const btn = document.getElementById('theme-toggle');
  const sun = document.getElementById('icon-sun');
  const moon = document.getElementById('icon-moon');

  function syncIcons() {
    const isDark = root.classList.contains('dark');
    sun?.classList.toggle('hidden', isDark);
    moon?.classList.toggle('hidden', !isDark);
  }
  syncIcons();

  btn?.addEventListener('click', () => {
    root.classList.toggle('dark');
    localStorage.setItem('theme', root.classList.contains('dark') ? 'dark' : 'light');
    syncIcons();
  });
</script>
