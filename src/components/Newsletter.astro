---
// Este formulário ainda não envia o e-mail para lugar nenhum — é só a
// interface. Quando você tiver uma conta em um serviço de e-mail
// marketing (ex: Mailchimp, Brevo), me avise que eu conecto o "action"
// deste formulário a ele em poucos minutos.
---

<section class="mx-auto max-w-3xl px-4 py-16">
  <div
    class="reveal rounded-2xl border p-8 text-center sm:p-12"
    style="border-color: var(--color-border); background: var(--color-accent-soft);"
  >
    <h2 class="font-display text-2xl font-semibold">Novidades direto no seu e-mail</h2>
    <p class="mx-auto mt-2 max-w-sm text-sm" style="color: var(--color-text-muted);">
      Avisamos quando lançarmos ferramentas novas. Sem spam.
    </p>

    <form class="mx-auto mt-6 flex max-w-sm gap-2">
      <input
        type="email"
        required
        placeholder="seu@email.com"
        class="w-full rounded-lg border px-4 py-2.5 text-sm outline-none focus:border-[var(--color-accent)]"
        style="border-color: var(--color-border); background: var(--color-surface);"
      />
      <button
        type="submit"
        class="shrink-0 rounded-lg px-4 py-2.5 text-sm font-medium text-white transition hover:opacity-90"
        style="background: var(--color-accent);"
      >
        Inscrever
      </button>
    </form>
  </div>
</section>
