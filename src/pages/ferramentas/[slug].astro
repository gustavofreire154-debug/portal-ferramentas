---
// Rota dinâmica: UMA página deste arquivo gera automaticamente TODAS as
// páginas de ferramentas, uma para cada arquivo dentro de src/content/tools.
// É isso que permite escalar para milhares de ferramentas sem criar
// milhares de arquivos de página — só de conteúdo.
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AdSlot from '../../components/AdSlot.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { categories } from '../../config/categories';
import PercentageCalculator from '../../islands/PercentageCalculator';
import WordCounter from '../../islands/WordCounter';
import BmiCalculator from '../../islands/BmiCalculator';
import ImageCompressor from '../../islands/ImageCompressor';
import PdfMerger from '../../islands/PdfMerger';
import CurrencyConverter from '../../islands/CurrencyConverter';
import JsonFormatter from '../../islands/JsonFormatter';
import BackgroundRemover from '../../islands/BackgroundRemover';
import ImageConverter from '../../islands/ImageConverter';
import ImageToPdf from '../../islands/ImageToPdf';
import PdfToImages from '../../islands/PdfToImages';
import PdfToWord from '../../islands/PdfToWord';
import MetaTagGenerator from '../../islands/MetaTagGenerator';
import KeywordDensityChecker from '../../islands/KeywordDensityChecker';
import RobotsTxtGenerator from '../../islands/RobotsTxtGenerator';
import UtmLinkGenerator from '../../islands/UtmLinkGenerator';
import MarketingRoiCalculator from '../../islands/MarketingRoiCalculator';
import HeadlineGenerator from '../../islands/HeadlineGenerator';
import AiPromptBuilder from '../../islands/AiPromptBuilder';
import AiTokenCalculator from '../../islands/AiTokenCalculator';
import AiCostComparator from '../../islands/AiCostComparator';
import SocialCharCounter from '../../islands/SocialCharCounter';
import HashtagGenerator from '../../islands/HashtagGenerator';
import FancyTextGenerator from '../../islands/FancyTextGenerator';
import CompoundInterestCalculator from '../../islands/CompoundInterestCalculator';
import LoanSimulator from '../../islands/LoanSimulator';
import EmergencyFundCalculator from '../../islands/EmergencyFundCalculator';
import GradeAverageCalculator from '../../islands/GradeAverageCalculator';
import GradeScaleConverter from '../../islands/GradeScaleConverter';
import PomodoroTimer from '../../islands/PomodoroTimer';
import PasswordGenerator from '../../islands/PasswordGenerator';
import QrCodeGenerator from '../../islands/QrCodeGenerator';
import NameDrawer from '../../islands/NameDrawer';

const KNOWN_TOOLS = [
  'calculadora-de-porcentagem',
  'contador-de-palavras',
  'calculadora-de-imc',
  'compressor-de-imagem',
  'juntar-pdf',
  'conversor-de-moedas',
  'formatador-de-json',
  'removedor-de-fundo',
  'conversor-de-imagem',
  'imagem-para-pdf',
  'pdf-para-jpg',
  'pdf-para-word',
  'gerador-de-meta-tags',
  'verificador-de-densidade-de-palavras-chave',
  'gerador-de-robots-txt',
  'gerador-de-link-utm',
  'calculadora-de-roi-de-marketing',
  'gerador-de-headlines',
  'montador-de-prompts-para-ia',
  'calculadora-de-tokens-de-ia',
  'comparador-de-custo-de-ia',
  'contador-de-caracteres-para-redes-sociais',
  'gerador-de-hashtags',
  'gerador-de-fonte-estilizada',
  'calculadora-de-juros-compostos',
  'simulador-de-financiamento',
  'calculadora-de-reserva-de-emergencia',
  'calculadora-de-media-escolar',
  'conversor-de-notas-e-conceitos',
  'cronometro-pomodoro',
  'gerador-de-senha',
  'gerador-de-qr-code',
  'sorteador-de-nomes',
];

export async function getStaticPaths() {
  const tools = await getCollection('tools');
  return tools.map((tool) => ({
    params: { slug: tool.id },
    props: { tool },
  }));
}

interface Props {
  tool: CollectionEntry<'tools'>;
}

const { tool } = Astro.props;
const { Content } = await render(tool);

const categoryInfo = categories.find((c) => c.slug === tool.data.category);

const breadcrumbItems = [
  { name: 'Início', path: '/' },
  { name: 'Ferramentas', path: '/ferramentas' },
  { name: categoryInfo?.name ?? tool.data.category, path: `/categorias/${tool.data.category}` },
  { name: tool.data.name, path: `/ferramentas/${tool.id}` },
];

// Schema.org FAQPage: quando a ferramenta tem perguntas frequentes,
// isso pode fazer o Google exibir as respostas direto no resultado
// de busca (os "acordeões" que aparecem embaixo do link azul).
const faqSchema =
  tool.data.faq.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: tool.data.faq.map((item) => ({
          '@type': 'Question',
          name: item.question,
          acceptedAnswer: { '@type': 'Answer', text: item.answer },
        })),
      }
    : null;
---

<Layout title={tool.data.seo.title} description={tool.data.seo.description}>
  {faqSchema && (
    <script slot="head" type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  )}
  <article class="mx-auto max-w-3xl px-4 py-16">
    <Breadcrumbs items={breadcrumbItems} />
    <p class="eyebrow">{tool.data.category}</p>
    <h1 class="font-display mt-2 text-3xl font-bold">{tool.data.name}</h1>
    <div class="mt-3 h-0.5 w-12 rounded-full" style="background: var(--gradient-brand);"></div>
    <p class="mt-4" style="color: var(--color-text-muted);">{tool.data.description}</p>

    <div class="mt-10">
      {tool.id === 'calculadora-de-porcentagem' && <PercentageCalculator client:load />}
      {tool.id === 'contador-de-palavras' && <WordCounter client:load />}
      {tool.id === 'calculadora-de-imc' && <BmiCalculator client:load />}
      {tool.id === 'compressor-de-imagem' && <ImageCompressor client:load />}
      {tool.id === 'juntar-pdf' && <PdfMerger client:load />}
      {tool.id === 'conversor-de-moedas' && <CurrencyConverter client:load />}
      {tool.id === 'formatador-de-json' && <JsonFormatter client:load />}
      {tool.id === 'removedor-de-fundo' && <BackgroundRemover client:load />}
      {tool.id === 'conversor-de-imagem' && <ImageConverter client:load />}
      {tool.id === 'imagem-para-pdf' && <ImageToPdf client:load />}
      {tool.id === 'pdf-para-jpg' && <PdfToImages client:load />}
      {tool.id === 'pdf-para-word' && <PdfToWord client:load />}
      {tool.id === 'gerador-de-meta-tags' && <MetaTagGenerator client:load />}
      {tool.id === 'verificador-de-densidade-de-palavras-chave' && <KeywordDensityChecker client:load />}
      {tool.id === 'gerador-de-robots-txt' && <RobotsTxtGenerator client:load />}
      {tool.id === 'gerador-de-link-utm' && <UtmLinkGenerator client:load />}
      {tool.id === 'calculadora-de-roi-de-marketing' && <MarketingRoiCalculator client:load />}
      {tool.id === 'gerador-de-headlines' && <HeadlineGenerator client:load />}
      {tool.id === 'montador-de-prompts-para-ia' && <AiPromptBuilder client:load />}
      {tool.id === 'calculadora-de-tokens-de-ia' && <AiTokenCalculator client:load />}
      {tool.id === 'comparador-de-custo-de-ia' && <AiCostComparator client:load />}
      {tool.id === 'contador-de-caracteres-para-redes-sociais' && <SocialCharCounter client:load />}
      {tool.id === 'gerador-de-hashtags' && <HashtagGenerator client:load />}
      {tool.id === 'gerador-de-fonte-estilizada' && <FancyTextGenerator client:load />}
      {tool.id === 'calculadora-de-juros-compostos' && <CompoundInterestCalculator client:load />}
      {tool.id === 'simulador-de-financiamento' && <LoanSimulator client:load />}
      {tool.id === 'calculadora-de-reserva-de-emergencia' && <EmergencyFundCalculator client:load />}
      {tool.id === 'calculadora-de-media-escolar' && <GradeAverageCalculator client:load />}
      {tool.id === 'conversor-de-notas-e-conceitos' && <GradeScaleConverter client:load />}
      {tool.id === 'cronometro-pomodoro' && <PomodoroTimer client:load />}
      {tool.id === 'gerador-de-senha' && <PasswordGenerator client:load />}
      {tool.id === 'gerador-de-qr-code' && <QrCodeGenerator client:load />}
      {tool.id === 'sorteador-de-nomes' && <NameDrawer client:load />}
      {!KNOWN_TOOLS.includes(tool.id) && (
        <div
          class="glass-panel rounded-xl border border-dashed p-8 text-center text-sm"
          style="border-color: var(--color-border); color: var(--color-text-muted);"
        >
          {/* Esta ferramenta ainda não tem a calculadora interativa implementada */}
          Esta ferramenta ainda está sendo construída — em breve estará disponível aqui.
        </div>
      )}
    </div>

    <div class="prose dark:prose-invert mt-10 max-w-none">
      <Content />
    </div>

    {/* Anúncio posicionado só aqui: depois que o usuário já usou a
        ferramenta e leu o conteúdo — nunca perto dos campos de entrada,
        nunca antes do usuário conseguir usar a calculadora. */}
    <AdSlot slot="toolBottom" />

    {tool.data.faq.length > 0 && (
      <section class="mt-12">
        <h2 class="font-display text-xl font-semibold">Perguntas frequentes</h2>
        <dl class="mt-4 space-y-4">
          {tool.data.faq.map((item) => (
            <div>
              <dt class="font-medium">{item.question}</dt>
              <dd class="mt-1 text-sm" style="color: var(--color-text-muted);">{item.answer}</dd>
            </div>
          ))}
        </dl>
      </section>
    )}
  </article>
</Layout>
